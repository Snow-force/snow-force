{
  "name": "snowforce-super-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test tests/*.check.mjs",
    "test:coverage": "node --experimental-test-coverage --test tests/*.check.mjs",
    "build": "wrangler deploy --dry-run --outdir .build",
    "db:local": "wrangler d1 migrations apply super-agent --local",
    "db:remote": "wrangler d1 migrations apply super-agent --remote",
    "deploy": "wrangler deploy",
    "runner": "node runner.mjs"
  },
  "devDependencies": {
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  },
  "dependencies": {
    "railway": "^3.16.0"
  }
}
