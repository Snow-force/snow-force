FROM node:24.22.1-bookworm-slim AS build
WORKDIR /opt/web
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY next.config.js tsconfig.json next-env.d.ts postcss.config.js tailwind.config.ts eslint.config.mjs vitest.config.mts ./
COPY proxy.ts ./
COPY src ./src
COPY scripts/shop-performance-summary.mjs ./scripts/shop-performance-summary.mjs
COPY public ./public
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_SITE_URL=https://snow-force.com
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_COMMERCE_STRIPE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_COMMERCE_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_COMMERCE_STRIPE_PUBLISHABLE_KEY
RUN npm run build

FROM node:24.22.1-bookworm-slim AS runtime
WORKDIR /opt/web
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=node:node /opt/web/.next/standalone/ ./
COPY --from=build --chown=node:node /opt/web/.next/static/ ./.next/static/
COPY --from=build --chown=node:node /opt/web/public/ ./public/
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
