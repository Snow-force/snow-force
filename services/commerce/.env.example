# Copy to .env.development locally. Never commit filled values.
# Existing Snow-Force web PostgreSQL database; use a commerce-only role.
DATABASE_URL=
DATABASE_SCHEMA=commerce
SUPABASE_URL=https://bhmwxkynhyhquspiyact.supabase.co
SUPABASE_PUBLISHABLE_KEY=
JWT_SECRET=
COOKIE_SECRET=
# Admin password reset mail only; server-side. Use a verified Resend sending key.
COMMERCE_RESEND_API_KEY=
STORE_CORS=http://127.0.0.1:3100
ADMIN_CORS=http://127.0.0.1:9000
AUTH_CORS=http://127.0.0.1:3100,http://127.0.0.1:9000
MEDUSA_WORKER_MODE=shared
# Explicitly set management for the first public deployment. Sales requires a separate launch review.
COMMERCE_OPERATING_MODE=management
REDIS_URL=
# Railway private TLS Redis CA (PEM, actual newlines or escaped \n). Server-only trust configuration.
REDIS_CA_CERT=
# Production certificate verification: PEM CA from Supabase Connect panel.
DATABASE_CA_CERT=
# Backend Stripe test keys only while validating. Separate commerce webhook secret.
COMMERCE_STRIPE_API_KEY=
COMMERCE_STRIPE_WEBHOOK_SECRET=
COMMERCE_TAX_POLICY_CONFIRMED=false
# Private order projection bridge. Same independently generated secret in root .env.local.
COMMERCE_ORDER_SYNC_SECRET=
SNOWFORCE_STOREFRONT_URL=http://127.0.0.1:3100
# Used only by the reviewed one-off draft importer, never by product reads.
SNOWFORCE_DRAFT_MANIFEST=
SNOWFORCE_SERVICE_ZONE_ID=
SNOWFORCE_FULFILLMENT_MANIFEST=
# Native Admin uploads use the existing Supabase Storage S3 endpoint.
# Generate the access pair in Supabase Storage settings; server-only credentials.
S3_ENDPOINT=https://bhmwxkynhyhquspiyact.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-2
S3_BUCKET=shop-products
S3_FILE_URL=https://bhmwxkynhyhquspiyact.supabase.co/storage/v1/object/public/shop-products
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
