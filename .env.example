# Supabase public access. Required for public persisted event reads and Supabase auth flows.
# Get these from your Supabase project dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Supabase server-only admin access. Used by server actions after Supabase
# staff auth (staff_roles table) gates admin mutations. Never expose this
# key with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-server-only-secret-key-here

# Resend email service (go to https://resend.com → API Keys)
RESEND_API_KEY=

# Staff notification email
STAFF_NOTIFICATION_EMAIL=staff@snowforce.example.com

# Google Cloud Translation API. Server-side only; restrict this key to the
# Cloud Translation API in Google Cloud Console.
GOOGLE_TRANSLATE_API_KEY=

# Local signed admin session. Set strong random values before using staff admin.

# Public base URL of the deployed site. Used for SEO canonical URLs, OG tags, Stripe redirect URLs, and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe secret key from Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Stripe webhook signing secret from Stripe Dashboard → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key from Stripe Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Medusa shop; customer accounts use the existing Supabase Auth above.
MEDUSA_BACKEND_URL=http://127.0.0.1:9000
MEDUSA_PUBLISHABLE_KEY=
SHOP_CART_COOKIE_SECRET=
NEXT_PUBLIC_COMMERCE_STRIPE_PUBLISHABLE_KEY=
# Server-only bridge; same independent value as services/commerce/.env.development.
COMMERCE_ORDER_SYNC_SECRET=
# Enable only after the draft-ledger migration and backend endpoints are verified.
SHOP_CHECKOUT_DRAFTS=false
